generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StoreStatus {
  active
  inactive
  suspended
  trial
}

enum UserRole {
  super_admin
  store_owner
  manager
  employee
}

enum UserStatus {
  active
  inactive
  suspended
}

enum SubStatus {
  active
  inactive
  past_due
  cancelled
  expired
  trial
}

enum BillingCycle {
  monthly
  yearly
}

enum BarcodeType {
  ean13
  ean8
  upca
  upce
  code128
  code39
  qrcode
}

enum ProductType {
  good
  service
}

enum PaymentStatus {
  paid
  partial
  unpaid
  refunded
}

enum PaymentMethod {
  cash
  card
  mobile_payment
  bank_transfer
  credit
  other
}

enum SaleStatus {
  completed
  pending
  cancelled
  refunded
  on_hold
}

enum DiscountType {
  percentage
  fixed
}

enum PurchaseStatus {
  received
  pending
  cancelled
  partial
}

enum ExpensePaymentMethod {
  cash
  card
  mobile
  bank
  other
}

enum RecurringFrequency {
  daily
  weekly
  monthly
  yearly
}

enum BackupType {
  full
  store
  manual
  scheduled
}

enum BackupStatus {
  pending
  completed
  failed
}

model Store {
  id                 BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  name               String       @db.VarChar(200)
  slug               String       @unique @db.VarChar(100)
  email              String       @unique @db.VarChar(100)
  phone              String?      @db.VarChar(20)
  address            String?      @db.Text
  city               String?      @db.VarChar(100)
  state              String?      @db.VarChar(100)
  postal_code        String?      @db.VarChar(20)
  country            String?      @default("US") @db.VarChar(100)
  logo               String?      @db.VarChar(255)
  currency           String?      @default("USD") @db.VarChar(10)
  timezone           String?      @default("UTC") @db.VarChar(50)
  tax_rate           Decimal?     @default(0.00) @db.Decimal(5, 2)
  tax_id             String?      @db.VarChar(50)
  receipt_footer     String?      @db.Text
  receipt_header     String?      @db.Text
  default_language   String?      @default("en") @db.VarChar(10)
  date_format        String?      @default("YYYY-MM-DD") @db.VarChar(20)
  is_active          Boolean?     @default(true)
  status             StoreStatus? @default(trial)
  trial_ends_at      DateTime?    @db.DateTime(0)
  subscription_ends_at DateTime?  @db.DateTime(0)
  max_products       Int?         @default(100)
  max_staff          Int?         @default(2)
  domain             String?      @unique @db.VarChar(255)
  subdomain          String?      @unique @db.VarChar(100)
  settings           Json?        @default("{}")
  created_at         DateTime     @default(now()) @db.Timestamp(0)
  updated_at         DateTime     @updatedAt @db.Timestamp(0)

  users           User[]
  categories      Category[]
  products        Product[]
  customers       Customer[]
  suppliers       Supplier[]
  sales           Sale[]
  purchases       Purchase[]
  expenses        Expense[]
  payments        Payment[]
  activityLogs    ActivityLog[]
  notifications   Notification[]
  subscriptions   Subscription[]
  backups         Backup[]

  @@index([email], map: "idx_stores_email")
  @@index([status], map: "idx_stores_status")
  @@index([subdomain], map: "idx_stores_subdomain")
  @@index([slug], map: "idx_stores_slug")
  @@map("stores")
}

model User {
  id               BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  store_id         BigInt?    @db.UnsignedBigInt
  name             String     @db.VarChar(100)
  email            String     @db.VarChar(100)
  password         String     @db.VarChar(255)
  phone            String?    @db.VarChar(20)
  avatar           String?    @db.VarChar(255)
  role             UserRole?  @default(employee)
  permissions      Json?      @default("{}")
  status           UserStatus? @default(active)
  email_verified_at DateTime? @db.DateTime(0)
  last_login_at    DateTime?  @db.DateTime(0)
  refresh_token    String?    @db.Text
  created_at       DateTime   @default(now()) @db.Timestamp(0)
  updated_at       DateTime   @updatedAt @db.Timestamp(0)

  store          Store?        @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "fk_user_store")
  sales          Sale[]
  purchases      Purchase[]
  expenses       Expense[]
  activityLogs   ActivityLog[]
  notifications  Notification[]

  @@index([store_id], map: "idx_users_store")
  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@unique([store_id, email], map: "idx_users_store_email")
  @@map("users")
}

model SubscriptionPlan {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name          String      @db.VarChar(100)
  slug          String      @unique @db.VarChar(100)
  description   String?     @db.Text
  price_monthly Decimal     @default(0.00) @db.Decimal(10, 2)
  price_yearly  Decimal     @default(0.00) @db.Decimal(10, 2)
  max_products  Int?        @default(100)
  max_staff     Int?        @default(2)
  max_stores    Int?        @default(1)
  features      Json?       @default("[]")
  is_active     Boolean?    @default(true)
  sort_order    Int?        @default(0)
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  updated_at    DateTime    @updatedAt @db.Timestamp(0)

  subscriptions Subscription[]

  @@index([slug], map: "idx_plans_slug")
  @@index([is_active], map: "idx_plans_active")
  @@map("subscription_plans")
}

model Subscription {
  id                  BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  store_id            BigInt       @db.UnsignedBigInt
  plan_id             BigInt       @db.UnsignedBigInt
  status              SubStatus?   @default(trial)
  billing_cycle       BillingCycle? @default(monthly)
  start_date          DateTime?    @map("started_at") @db.DateTime(0)
  trial_ends_at       DateTime?    @db.DateTime(0)
  current_period_ends_at DateTime?  @db.DateTime(0)
  cancelled_at        DateTime?    @db.DateTime(0)
  payment_method      String?      @db.VarChar(50)
  payment_details     Json?        @default("{}")
  auto_renew          Boolean?     @default(true)
  created_at          DateTime     @default(now()) @db.Timestamp(0)
  updated_at          DateTime     @updatedAt @db.Timestamp(0)

  store Store              @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "fk_sub_store")
  plan  SubscriptionPlan   @relation(fields: [plan_id], references: [id], onDelete: Cascade, map: "fk_sub_plan")

  @@index([store_id], map: "idx_sub_store")
  @@index([status], map: "idx_sub_status")
  @@map("subscriptions")
}

model Category {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  store_id    BigInt    @db.UnsignedBigInt
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(100)
  description String?   @db.Text
  parent_id   BigInt?   @db.UnsignedBigInt
  sort_order  Int?      @default(0)
  is_active   Boolean?  @default(true)
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  updated_at  DateTime  @updatedAt @db.Timestamp(0)

  store    Store      @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "fk_cat_store")
  parent   Category?  @relation("CategoryParent", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]

  @@index([store_id], map: "idx_cat_store")
  @@unique([store_id, slug], map: "idx_cat_store_slug")
  @@map("categories")
}

model Product {
  id                   BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  store_id             BigInt       @db.UnsignedBigInt
  category_id          BigInt?      @db.UnsignedBigInt
  name                 String       @db.VarChar(200)
  slug                 String       @db.VarChar(200)
  sku                  String?      @db.VarChar(50)
  barcode              String?      @db.VarChar(100)
  barcode_type         BarcodeType? @default(code128)
  description          String?      @db.Text
  purchase_price       Decimal?     @default(0.00) @db.Decimal(12, 2)
  selling_price        Decimal?     @default(0.00) @db.Decimal(12, 2)
  wholesale_price      Decimal?     @db.Decimal(12, 2)
  discount_price       Decimal?     @db.Decimal(12, 2)
  stock_quantity       Decimal?     @default(0) @db.Decimal(12, 3)
  low_stock_threshold  Decimal?     @default(10) @db.Decimal(12, 3)
  unit                 String?      @default("pcs") @db.VarChar(20)
  tax_percentage       Decimal?     @default(0.00) @db.Decimal(5, 2)
  images               Json?        @default("[]")
  is_active            Boolean?     @default(true)
  is_featured          Boolean?     @default(false)
  track_stock          Boolean?     @default(true)
  type                 ProductType? @default(good)
  expiry_date          DateTime?    @db.Date
  manufacturer         String?      @db.VarChar(200)
  batch_number         String?      @db.VarChar(50)
  requires_prescription Boolean?    @default(false)
  created_at           DateTime     @default(now()) @db.Timestamp(0)
  updated_at           DateTime     @updatedAt @db.Timestamp(0)

  store         Store          @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "fk_prod_store")
  category      Category?      @relation(fields: [category_id], references: [id], onDelete: SetNull, map: "fk_prod_category")
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@index([store_id], map: "idx_prod_store")
  @@index([category_id], map: "idx_prod_category")
  @@index([barcode], map: "idx_prod_barcode")
  @@index([sku], map: "idx_prod_sku")
  @@index([name], map: "idx_prod_name")
  @@index([stock_quantity], map: "idx_prod_stock")
  @@index([is_active], map: "idx_prod_active")
  @@unique([store_id, slug], map: "idx_prod_store_slug")
  @@map("products")
}

model Customer {
  id              BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  store_id        BigInt     @db.UnsignedBigInt
  name            String     @db.VarChar(100)
  email           String?    @db.VarChar(100)
  phone           String?    @db.VarChar(20)
  address         String?    @db.Text
  city            String?    @db.VarChar(100)
  state           String?    @db.VarChar(100)
  postal_code     String?    @db.VarChar(20)
  total_purchases Decimal?   @default(0.00) @db.Decimal(12, 2)
  total_paid      Decimal?   @default(0.00) @db.Decimal(12, 2)
  balance         Decimal?   @default(0.00) @db.Decimal(12, 2)
  loyalty_points  Int?       @default(0)
  notes           String?    @db.Text
  is_active       Boolean?   @default(true)
  created_at      DateTime   @default(now()) @db.Timestamp(0)
  updated_at      DateTime   @updatedAt @db.Timestamp(0)

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "fk_cust_store")
  sales Sale[]

  @@index([store_id], map: "idx_cust_store")
  @@index([phone], map: "idx_cust_phone")
  @@index([email], map: "idx_cust_email")
  @@map("customers")
}

model Supplier {
  id              BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  store_id        BigInt     @db.UnsignedBigInt
  name            String     @db.VarChar(100)
  company         String?    @db.VarChar(200)
  email           String?    @db.VarChar(100)
  phone           String?    @db.VarChar(20)
  address         String?    @db.Text
  city            String?    @db.VarChar(100)
  state           String?    @db.VarChar(100)
  postal_code     String?    @db.VarChar(20)
  total_purchases Decimal?   @default(0.00) @db.Decimal(12, 2)
  total_paid      Decimal?   @default(0.00) @db.Decimal(12, 2)
  balance         Decimal?   @default(0.00) @db.Decimal(12, 2)
  notes           String?    @db.Text
  is_active       Boolean?   @default(true)
  created_at      DateTime   @default(now()) @db.Timestamp(0)
  updated_at      DateTime   @updatedAt @db.Timestamp(0)

  store     Store      @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "fk_supp_store")
  purchases Purchase[]

  @@index([store_id], map: "idx_supp_store")
  @@index([phone], map: "idx_supp_phone")
  @@map("suppliers")
}

model Sale {
  id                  BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  store_id            BigInt         @db.UnsignedBigInt
  invoice_number      String         @db.VarChar(50)
  customer_id         BigInt?        @db.UnsignedBigInt
  user_id             BigInt?        @db.UnsignedBigInt
  subtotal            Decimal?       @default(0.00) @db.Decimal(12, 2)
  discount_type       DiscountType?
  discount_value      Decimal?       @default(0.00) @db.Decimal(12, 2)
  discount_amount     Decimal?       @default(0.00) @db.Decimal(12, 2)
  tax_amount          Decimal?       @default(0.00) @db.Decimal(12, 2)
  shipping_cost       Decimal?       @default(0.00) @db.Decimal(12, 2)
  total_amount        Decimal?       @default(0.00) @db.Decimal(12, 2)
  paid_amount         Decimal?       @default(0.00) @db.Decimal(12, 2)
  due_amount          Decimal?       @default(0.00) @db.Decimal(12, 2)
  payment_status      PaymentStatus? @default(unpaid)
  payment_method      PaymentMethod? @default(cash)
  status              SaleStatus?    @default(completed)
  notes               String?        @db.Text
  prescription_id     String?        @db.VarChar(50)
  is_pharmacy         Boolean?       @default(false)
  created_at          DateTime       @default(now()) @db.Timestamp(0)
  updated_at          DateTime       @updatedAt @db.Timestamp(0)

  store    Store      @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "fk_sale_store")
  customer Customer?  @relation(fields: [customer_id], references: [id], onDelete: SetNull, map: "fk_sale_customer")
  user     User?      @relation(fields: [user_id], references: [id], onDelete: SetNull, map: "fk_sale_user")
  items    SaleItem[]
  payments Payment[]

  @@index([store_id], map: "idx_sale_store")
  @@index([customer_id], map: "idx_sale_customer")
  @@index([user_id], map: "idx_sale_user")
  @@index([invoice_number], map: "idx_sale_invoice")
  @@index([status], map: "idx_sale_status")
  @@index([created_at], map: "idx_sale_created")
  @@index([payment_status], map: "idx_sale_payment_status")
  @@map("sales")
}

model SaleItem {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  sale_id             BigInt   @db.UnsignedBigInt
  product_id          BigInt   @db.UnsignedBigInt
  quantity            Decimal  @default(1) @db.Decimal(12, 3)
  unit_price          Decimal  @db.Decimal(12, 2)
  discount_percentage Decimal? @default(0.00) @db.Decimal(5, 2)
  discount_amount     Decimal? @default(0.00) @db.Decimal(12, 2)
  tax_percentage      Decimal? @default(0.00) @db.Decimal(5, 2)
  tax_amount          Decimal? @default(0.00) @db.Decimal(12, 2)
  total               Decimal  @db.Decimal(12, 2)
  created_at          DateTime @default(now()) @db.Timestamp(0)

  sale    Sale    @relation(fields: [sale_id], references: [id], onDelete: Cascade, map: "fk_si_sale")
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_si_product")

  @@index([sale_id], map: "idx_si_sale")
  @@index([product_id], map: "idx_si_product")
  @@map("sale_items")
}

model Purchase {
  id               BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  store_id         BigInt          @db.UnsignedBigInt
  purchase_number  String          @db.VarChar(50)
  supplier_id      BigInt?         @db.UnsignedBigInt
  user_id          BigInt?         @db.UnsignedBigInt
  subtotal         Decimal?        @default(0.00) @db.Decimal(12, 2)
  discount_amount  Decimal?        @default(0.00) @db.Decimal(12, 2)
  tax_amount       Decimal?        @default(0.00) @db.Decimal(12, 2)
  shipping_cost    Decimal?        @default(0.00) @db.Decimal(12, 2)
  total_amount     Decimal?        @default(0.00) @db.Decimal(12, 2)
  paid_amount      Decimal?        @default(0.00) @db.Decimal(12, 2)
  due_amount       Decimal?        @default(0.00) @db.Decimal(12, 2)
  payment_status   PaymentStatus?  @default(unpaid)
  status           PurchaseStatus? @default(pending)
  notes            String?         @db.Text
  created_at       DateTime        @default(now()) @db.Timestamp(0)
  updated_at       DateTime        @updatedAt @db.Timestamp(0)

  store    Store          @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "fk_purch_store")
  supplier Supplier?      @relation(fields: [supplier_id], references: [id], onDelete: SetNull, map: "fk_purch_supplier")
  user     User?          @relation(fields: [user_id], references: [id], onDelete: SetNull, map: "fk_purch_user")
  items    PurchaseItem[]
  payments Payment[]

  @@index([store_id], map: "idx_purch_store")
  @@index([supplier_id], map: "idx_purch_supplier")
  @@index([purchase_number], map: "idx_purch_number")
  @@index([status], map: "idx_purch_status")
  @@index([created_at], map: "idx_purch_created")
  @@map("purchases")
}

model PurchaseItem {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  purchase_id      BigInt   @db.UnsignedBigInt
  product_id       BigInt   @db.UnsignedBigInt
  quantity         Decimal  @default(1) @db.Decimal(12, 3)
  unit_cost        Decimal  @db.Decimal(12, 2)
  discount_amount  Decimal? @default(0.00) @db.Decimal(12, 2)
  tax_percentage   Decimal? @default(0.00) @db.Decimal(5, 2)
  tax_amount       Decimal? @default(0.00) @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  created_at       DateTime @default(now()) @db.Timestamp(0)

  purchase Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade, map: "fk_pi_purchase")
  product  Product  @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_pi_product")

  @@index([purchase_id], map: "idx_pi_purchase")
  @@index([product_id], map: "idx_pi_product")
  @@map("purchase_items")
}

model Expense {
  id                 BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  store_id           BigInt                @db.UnsignedBigInt
  user_id            BigInt?               @db.UnsignedBigInt
  category           String                @db.VarChar(100)
  amount             Decimal               @db.Decimal(12, 2)
  description        String?               @db.Text
  reference_number   String?               @db.VarChar(50)
  expense_date       DateTime              @db.Date
  payment_method     ExpensePaymentMethod? @default(cash)
  is_recurring       Boolean?              @default(false)
  recurring_frequency RecurringFrequency?
  recurring_end_date DateTime?             @db.Date
  notes              String?               @db.Text
  created_at         DateTime              @default(now()) @db.Timestamp(0)
  updated_at         DateTime              @updatedAt @db.Timestamp(0)

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "fk_exp_store")
  user  User? @relation(fields: [user_id], references: [id], onDelete: SetNull, map: "fk_exp_user")

  @@index([store_id], map: "idx_exp_store")
  @@index([category], map: "idx_exp_category")
  @@index([expense_date], map: "idx_exp_date")
  @@map("expenses")
}

model Payment {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  store_id         BigInt         @db.UnsignedBigInt
  sale_id          BigInt?        @db.UnsignedBigInt
  purchase_id      BigInt?        @db.UnsignedBigInt
  amount           Decimal        @db.Decimal(12, 2)
  payment_method   PaymentMethod? @default(cash)
  reference_number String?        @db.VarChar(100)
  notes            String?        @db.Text
  payment_date     DateTime       @default(now()) @db.DateTime(0)
  created_at       DateTime       @default(now()) @db.Timestamp(0)
  updated_at       DateTime       @updatedAt @db.Timestamp(0)

  store    Store     @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "fk_pay_store")
  sale     Sale?     @relation(fields: [sale_id], references: [id], onDelete: SetNull, map: "fk_pay_sale")
  purchase Purchase? @relation(fields: [purchase_id], references: [id], onDelete: SetNull, map: "fk_pay_purchase")

  @@index([store_id], map: "idx_pay_store")
  @@index([sale_id], map: "idx_pay_sale")
  @@index([purchase_id], map: "idx_pay_purchase")
  @@index([payment_date], map: "idx_pay_date")
  @@map("payments")
}

model ActivityLog {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  store_id    BigInt?  @db.UnsignedBigInt
  user_id     BigInt?  @db.UnsignedBigInt
  action      String   @db.VarChar(100)
  entity_type String?  @db.VarChar(50)
  entity_id   BigInt?  @db.UnsignedBigInt
  description String?  @db.Text
  metadata    Json?    @default("{}")
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)

  store Store? @relation(fields: [store_id], references: [id], onDelete: SetNull, map: "fk_al_store")
  user  User?  @relation(fields: [user_id], references: [id], onDelete: SetNull, map: "fk_al_user")

  @@index([store_id], map: "idx_al_store")
  @@index([user_id], map: "idx_al_user")
  @@index([action], map: "idx_al_action")
  @@index([created_at], map: "idx_al_created")
  @@map("activity_logs")
}

model Notification {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  store_id   BigInt?   @db.UnsignedBigInt
  user_id    BigInt?   @db.UnsignedBigInt
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(200)
  message    String?   @db.Text
  data       Json?     @default("{}")
  is_read    Boolean?  @default(false)
  read_at    DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.Timestamp(0)

  store Store? @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "fk_notif_store")
  user  User?  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_notif_user")

  @@index([store_id], map: "idx_notif_store")
  @@index([user_id], map: "idx_notif_user")
  @@index([is_read], map: "idx_notif_read")
  @@index([created_at], map: "idx_notif_created")
  @@map("notifications")
}

model Backup {
  id         BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  store_id   BigInt?      @db.UnsignedBigInt
  filename   String       @db.VarChar(255)
  filepath   String       @db.VarChar(500)
  file_size  BigInt?      @default(0)
  type       BackupType?  @default(manual)
  status     BackupStatus? @default(pending)
  notes      String?      @db.Text
  created_at DateTime     @default(now()) @db.Timestamp(0)

  store Store? @relation(fields: [store_id], references: [id], onDelete: SetNull, map: "fk_backup_store")

  @@index([store_id], map: "idx_backup_store")
  @@index([created_at], map: "idx_backup_created")
  @@map("backups")
}
